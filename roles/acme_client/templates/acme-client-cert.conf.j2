# Ansible managed - DO NOT EDIT MANUALLY
#
# Only what differs between zones; the rest is baked into acme-client-renew.sh.
# Single-quoted, and the role validates domains as plain DNS names, so nothing
# can close the quote and $DOMAINS is safe to word-split.

DOMAINS='{{ item.domains | default(["*." ~ item.zone, item.zone]) | join(" ") }}'

# lego names its output after the first domain, "*" -> "_". Templated rather than
# derived in shell so the script needs no string munging to find it.
CERT_BASE='{{ (item.domains | default(["*." ~ item.zone]))[0] | replace("*", "_") }}'

# Group of the deployed private key. gitea reads it as uid/gid 1000 and
# crash-loops otherwise; root-only consumers can leave it at root.
KEY_GROUP='{{ item.key_group | default("root") }}'
