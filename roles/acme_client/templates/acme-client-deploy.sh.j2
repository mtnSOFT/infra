#!/bin/sh
# Ansible managed - DO NOT EDIT MANUALLY
#
#   acme-client-deploy.sh <zone>
#
# Copy what lego holds into the paths the services read, then reload them.
#
# Compares first and stays silent when already current, so both the timer and a
# converge can call it unconditionally.
#
# Real files, never symlinks: consumer roles stat these paths without following
# links and require a regular file.
#
# Renamed, not written in place: owner and mode are set before the file becomes
# visible, so the key is never briefly world-readable and nothing reads a
# half-written PEM. The new inode is why the reload is not optional - Docker
# bind-mounts a file by inode, so a running container keeps the old one.
set -eu

ZONE="${1:-}"
if [ -z "$ZONE" ]; then
  echo "usage: $0 <zone>" >&2
  exit 2
fi

CONF="{{ acme_client_config_dir }}/certs/${ZONE}.conf"
if [ ! -f "$CONF" ]; then
  echo "acme-client: no configuration for '$ZONE' at $CONF" >&2
  exit 2
fi
# shellcheck source=/dev/null
. "$CONF"

# Nothing issued yet - a converge before the first run. Not an error.
if [ ! -f "$SRC_CERT" ] || [ ! -f "$SRC_KEY" ]; then
  exit 0
fi

# Already current: no copy, no reload, no output.
if cmp -s "$SRC_CERT" "$DST_CERT" && cmp -s "$SRC_KEY" "$DST_KEY"; then
  exit 0
fi

umask 077
install -o "$CERT_OWNER" -g "$CERT_GROUP" -m "$CERT_MODE" "$SRC_CERT" "$DST_CERT.new"
install -o "$KEY_OWNER" -g "$KEY_GROUP" -m "$KEY_MODE" "$SRC_KEY" "$DST_KEY.new"

# Same directory, so renames rather than copies.
mv -f "$DST_CERT.new" "$DST_CERT"
mv -f "$DST_KEY.new" "$DST_KEY"

# Marker that 9_certificate.yml matches on to report a change.
echo "acme-client: deployed $DST_CERT and $DST_KEY"

# Absent when the certificate has no consumers here.
if [ -x "$RELOAD_SCRIPT" ]; then
  exec "$RELOAD_SCRIPT"
fi
