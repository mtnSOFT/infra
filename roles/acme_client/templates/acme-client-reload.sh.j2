#!/bin/sh
# Ansible managed - DO NOT EDIT MANUALLY
#
# Tell the consumers of {{ item.zone }} that the certificate changed. Run by
# acme-client-deploy.sh, only after the new pair is in place.
#
# Not an optimisation: consumers read the certificate once at startup, and Docker
# bind-mounts a file by inode, so without this a renewal is invisible until
# something restarts for another reason - usually after expiry.
#
# No `set -e`: every command is attempted so one broken consumer cannot hide the
# rest. Non-zero exit if any failed, which fails the unit after the files are
# already deployed - the right order.
set -u

rc=0

{% for command in item.reload_commands %}
if ! {{ command }}; then
  echo "acme-client: reload failed for {{ item.zone }}: {{ command }}" >&2
  rc=1
fi
{% endfor %}

exit "$rc"
