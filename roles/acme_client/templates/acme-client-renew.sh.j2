#!/bin/sh
# Ansible managed - DO NOT EDIT MANUALLY
#
#   acme-client-renew.sh <zone> [--now]
#
# Obtain or renew one certificate, then deploy it. systemd passes just the zone;
# a converge adds --now, which drops lego's own sleep (up to 8 min whenever
# stdout is not a tty) so an interactive run does not look hung.
#
# The two subcommands are NOT interchangeable - picking between them is the point
# of this script:
#   run   - ALWAYS issues, ignoring what is on disk. On a schedule that exhausts
#           the limit (5 per name set per 7 days, no renewal exemption) in a week.
#   renew - reads the certificate and returns without network above --days.
# So: run once to bootstrap, renew after.
#
# Deploy runs unconditionally afterwards rather than as a lego --renew-hook: that
# way a converge repairs a missing deployed pair, and a failed deploy is retried
# next tick instead of skipped for three months as "fresh".
set -eu

# Same for every zone, so templated here rather than into each .conf.
EMAIL='{{ acme_client_email }}'
SERVER='{{ acme_client_server }}'
LEGO_BIN='/usr/local/lib/lego/{{ acme_client_lego_version }}/lego'
# Per CA host, so flipping SERVER to staging cannot clobber a production cert.
LEGO_DIR='/var/lib/acme_client/{{ acme_client_server | urlsplit("hostname") }}'
# Must be public resolvers - see acme_client_dns_resolvers in the role defaults.
RESOLVERS='{{ acme_client_dns_resolvers | join(" ") }}'
RENEW_DAYS=30

ZONE="${1:-}"
if [ -z "$ZONE" ]; then
  echo "usage: $0 <zone> [--now]" >&2
  exit 2
fi

CONF="/etc/acme-client/certs/${ZONE}.conf"
if [ ! -f "$CONF" ]; then
  echo "acme-client: no configuration for '$ZONE' at $CONF" >&2
  exit 2
fi
# shellcheck source=/dev/null
. "$CONF"

SRC_CERT="${LEGO_DIR}/certificates/${CERT_BASE}.crt"

no_sleep=""
if [ "${2:-}" = "--now" ]; then
  no_sleep="--no-random-sleep"
fi

# Global flags go before the subcommand. Appending to "$@" avoids a line
# continuation inside a for loop.
set -- --accept-tos \
  --email "$EMAIL" \
  --server "$SERVER" \
  --path "$LEGO_DIR" \
  --dns infomaniak \
  --key-type ec256

# Word splitting intended: validated as plain host:port and DNS names.
# shellcheck disable=SC2086
for resolver in $RESOLVERS; do
  set -- "$@" --dns.resolvers "$resolver"
done

# shellcheck disable=SC2086
for domain in $DOMAINS; do
  set -- "$@" -d "$domain"
done

if [ -f "$SRC_CERT" ]; then
  # $no_sleep is one optional flag or empty, so it stays unquoted.
  # shellcheck disable=SC2086
  "$LEGO_BIN" "$@" renew --days "$RENEW_DAYS" $no_sleep
else
  "$LEGO_BIN" "$@" run
fi

# If lego's naming ever changes, deploy would silently do nothing and leave a
# stale certificate until it expired. Fail loudly instead.
if [ ! -f "$SRC_CERT" ]; then
  echo "acme-client: lego reported success but $SRC_CERT is missing" >&2
  exit 1
fi

exec /usr/local/bin/acme-client-deploy.sh "$ZONE"
