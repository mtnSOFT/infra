# Ansible managed - DO NOT EDIT MANUALLY
#
# One instance per certificate, e.g. acme-client-renew@int.example.com.service.
# Started by the matching timer; running one by hand forces a check.
[Unit]
Description=Obtain or renew the %i certificate (ACME DNS-01)
Documentation=https://go-acme.github.io/lego/
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/acme-client-renew.sh %i

# Only the token's PATH. lego reads any INFOMANIAK_* from a <VAR>_FILE, keeping
# it out of this world-readable file and out of the env inherited by the reload
# commands, i.e. out of docker compose.
Environment=INFOMANIAK_ACCESS_TOKEN_FILE={{ acme_client_token_file }}
{% for key, value in acme_client_provider_env | dictsort %}
Environment={{ key }}={{ value }}
{% endfor %}

# Type=oneshot has no default timeout. An unbounded hang would leave the unit
# activating forever, and systemd skips a timer whose unit still runs - renewals
# would stop silently.
TimeoutStartSec={{ acme_client_renew_timeout }}

# Deliberately light: the reload commands run arbitrary things, and
# ProtectSystem= would block writes to the deploy directory.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

# No [Install]: the timer pulls this in.
