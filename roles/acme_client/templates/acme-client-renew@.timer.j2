# Ansible managed - DO NOT EDIT MANUALLY
#
# One instance per certificate. Each draws its own delay, so several
# certificates - and the same zone on several hosts - do not call the API at once.
[Unit]
Description=Daily check of the %i certificate

[Timer]
# Daily costs nothing (lego skips the network when not due) and gives ~30
# attempts before expiry. Odd minute + delay because CAs ask clients not to
# converge on round times.
OnCalendar={{ acme_client_renew_oncalendar }}
RandomizedDelaySec={{ acme_client_renew_randomized_delay }}

# Catch up after boot instead of skipping the day.
Persistent=true

Unit=acme-client-renew@%i.service

[Install]
WantedBy=timers.target
