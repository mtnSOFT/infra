#!/bin/bash
# {{ ansible_managed }}
# Prunes and compacts every client repository of this server. Runs as the borg
# user from borg-prune.service. Keeps going after a failing repository and exits
# non-zero at the end if any failed, so the unit shows up as failed.
set -uo pipefail

export HOME="{{ borg_server_home }}"
rc=0

prune_repo() {
  local client=$1
  shift
  export BORG_REPO="{{ borg_server_repos_dir }}/${client}"
  export BORG_PASSCOMMAND="cat {{ borg_server_passphrase_dir }}/${client}"

  echo "== ${client}"
  borg prune --lock-wait {{ borg_server_lock_wait }} --list --stats "$@" || rc=1
  borg compact --lock-wait {{ borg_server_lock_wait }} || rc=1
}

{% for client in borg_server_clients %}
{% set r = borg_server_retention | combine(hostvars[client].borgmatic_client_retention | default({})) %}
prune_repo {{ client | quote }}{% for k, v in r.items() | sort %} --{{ k | replace('_', '-') }} {{ v }}{% endfor %}

{% endfor %}
exit "$rc"
